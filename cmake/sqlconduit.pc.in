prefix="@_pc_prefix_expr@"
exec_prefix="${prefix}"
libdir="@_pc_libdir_expr@"
includedir="@_pc_includedir_expr@"

Name: sqlconduit
Description: C++17 database middleware core
URL: https://github.com/matergreen/sqlconduit
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lsqlconduit_core
Cflags: -I${includedir}
