{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/matergreen/SQLConduit/raw/v0.8.0/config/sqlconduit.schema.json",
  "title": "SQLConduit configuration",
  "description": "Configuration contract for SQLConduit 0.8.x. Unknown fields are rejected. Cross-reference and environment checks are performed by ConfigLoader/Client at runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["datasources"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "default_datasource": { "type": "string", "minLength": 1 },
    "heartbeat_interval_ms": { "type": "integer", "minimum": 0, "default": 5000 },
    "pool": { "$ref": "#/$defs/pool" },
    "retry": { "$ref": "#/$defs/retry" },
    "circuit_breaker": { "$ref": "#/$defs/circuitBreaker" },
    "observability": { "$ref": "#/$defs/observability" },
    "rate_limit": { "$ref": "#/$defs/rateLimit" },
    "sql_audit": { "$ref": "#/$defs/sqlAudit" },
    "query_cache": { "$ref": "#/$defs/queryCache" },
    "cursor": { "$ref": "#/$defs/cursor" },
    "prepared_cache": { "$ref": "#/$defs/preparedCache" },
    "async": { "$ref": "#/$defs/async" },
    "interceptors": { "$ref": "#/$defs/interceptors" },
    "datasources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/datasource" }
    },
    "groups": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/group" }
    }
  },
  "$defs": {
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "min": { "type": "integer", "minimum": 0, "default": 1 },
        "max": { "type": "integer", "minimum": 1, "default": 8 },
        "borrow_timeout_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 30000 },
        "idle_timeout_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 600000 },
        "max_lifetime_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 1800000 },
        "leak_detection_threshold_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 30000 },
        "validation_interval_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 30000 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "default": 1 },
        "initial_backoff_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 50 },
        "max_backoff_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 1000 },
        "retry_writes": { "type": "boolean", "default": false }
      }
    },
    "circuitBreaker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "failure_threshold": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "open_interval_ms": { "$ref": "#/$defs/positiveInteger", "default": 30000 }
      }
    },
    "sqlLog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "mode": { "type": "string", "enum": ["template", "full"], "default": "template" },
        "level": { "type": "string", "enum": ["debug", "info", "warn", "error"], "default": "debug" },
        "log_success": { "type": "boolean", "default": true },
        "log_errors": { "type": "boolean", "default": true },
        "slow_only": { "type": "boolean", "default": false },
        "sample_rate": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
        "max_sql_length": { "type": "integer", "minimum": 64, "default": 8192 },
        "max_param_length": { "type": "integer", "minimum": 1, "default": 256 },
        "include_string_values": { "type": "boolean", "default": false },
        "include_blob_values": { "type": "boolean", "default": false }
      }
    },
    "slowSql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "threshold_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 500 },
        "aggregate_capacity": { "type": "integer", "minimum": 1, "default": 1000 },
        "recent_capacity": { "$ref": "#/$defs/nonNegativeInteger", "default": 200 },
        "retain_rendered_sql": { "type": "boolean", "default": false },
        "max_sql_length": { "type": "integer", "minimum": 64, "default": 4096 },
        "histogram_buckets_ms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 },
          "default": [10, 50, 100, 200, 500, 1000, 3000, 10000],
          "description": "Values must also be strictly increasing; ConfigLoader enforces that semantic constraint."
        }
      }
    },
    "poolMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true }
      }
    },
    "statsReport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "interval_ms": { "type": "integer", "minimum": 1000, "default": 60000 },
        "file": { "type": "string", "default": "" },
        "format": { "type": "string", "enum": ["text", "json"], "default": "text" },
        "include_pool": { "type": "boolean", "default": true },
        "include_slow_sql": { "type": "boolean", "default": true },
        "slow_sql_limit": { "$ref": "#/$defs/nonNegativeInteger", "default": 10 }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sql_log": { "$ref": "#/$defs/sqlLog" },
        "slow_sql": { "$ref": "#/$defs/slowSql" },
        "pool_metrics": { "$ref": "#/$defs/poolMetrics" },
        "stats_report": { "$ref": "#/$defs/statsReport" }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "global_qps": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "per_fingerprint_qps": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "burst": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "fingerprint_mode": { "type": "string", "enum": ["off", "template", "full"], "default": "off" }
      }
    },
    "sqlAudit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "action": { "type": "string", "enum": ["warn", "block"], "default": "warn" },
        "block_no_where_dml": { "type": "boolean", "default": false },
        "require_limit_select": { "type": "boolean", "default": false },
        "enforce_read_only": { "type": "boolean", "default": false },
        "log_blocked": { "type": "boolean", "default": true },
        "blacklist_fingerprints": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "default": []
        },
        "whitelist_fingerprints": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "default": []
        }
      }
    },
    "queryCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "ttl_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 60000 },
        "max_entries": { "$ref": "#/$defs/nonNegativeInteger", "default": 1000 },
        "max_memory_bytes": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "cache_on_replica_only": { "type": "boolean", "default": false }
      }
    },
    "cursor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "default_batch_size": { "$ref": "#/$defs/nonNegativeInteger", "default": 256 },
        "max_open_cursors": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "allow_scrollable": { "type": "boolean", "default": false }
      }
    },
    "preparedCache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "max_per_connection": { "$ref": "#/$defs/nonNegativeInteger", "default": 128 }
      }
    },
    "async": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "threads": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "queue_size": { "$ref": "#/$defs/positiveInteger", "default": 4096 },
        "statement_timeout_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 }
      }
    },
    "interceptors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false }
      }
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "verify_peer": { "type": "boolean", "default": true },
        "ca": { "type": "string", "default": "" },
        "cert": { "type": "string", "default": "" },
        "key": { "type": "string", "default": "" }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "service_name": { "type": "string", "minLength": 1 },
        "sid": { "type": "string", "minLength": 1 },
        "wallet_location": { "type": "string", "default": "" },
        "server_cert_dn": { "type": "string", "default": "" },
        "charset_id": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 873 },
        "lob_max_bytes": { "type": "integer", "minimum": 1, "default": 4194304 },
        "blob_bind": { "type": "string", "enum": ["auto", "raw", "lob"], "default": "auto" }
      },
      "not": { "required": ["service_name", "sid"] }
    },
    "datasource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1, "description": "Built-ins are mysql, postgres, odbc, and oracle; custom registered driver names are allowed." },
        "host": { "type": "string", "default": "" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535, "default": 0 },
        "user": { "type": "string", "default": "" },
        "password": { "type": "string", "default": "", "writeOnly": true },
        "password_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$", "writeOnly": true },
        "database": { "type": "string", "default": "" },
        "dsn": { "type": "string", "default": "" },
        "connection_timeout_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 5000 },
        "socket_timeout_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "query_timeout_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "max_result_rows": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "tls": { "$ref": "#/$defs/tls" },
        "oracle": { "$ref": "#/$defs/oracle" },
        "extra": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["oracle"] },
          "then": { "properties": { "type": { "const": "oracle" } } }
        },
        {
          "if": { "properties": { "type": { "const": "oracle" } }, "required": ["type"] },
          "then": {
            "not": {
              "allOf": [
                { "required": ["database"] },
                { "properties": { "oracle": { "required": ["sid"] } }, "required": ["oracle"] }
              ]
            }
          }
        }
      ]
    },
    "replica": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "weight": { "type": "integer", "minimum": 1, "maximum": 100, "default": 1 }
          }
        }
      ]
    },
    "writeBuffer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": false },
        "acknowledge_data_loss_and_duplicates": { "type": "boolean", "default": false },
        "max_queue": { "type": "integer", "minimum": 1, "default": 1000 },
        "ttl_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 30000 },
        "flush_interval_ms": { "$ref": "#/$defs/positiveInteger", "default": 1000 }
      },
      "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
      "then": {
        "required": ["acknowledge_data_loss_and_duplicates"],
        "properties": { "acknowledge_data_loss_and_duplicates": { "const": true } }
      }
    },
    "failover": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primaries": {
          "type": "array",
          "default": [],
          "items": { "type": "string", "minLength": 1 }
        },
        "acknowledge_external_fencing": { "type": "boolean", "default": false },
        "require_healthy": { "type": "boolean", "default": false },
        "write_buffer": { "$ref": "#/$defs/writeBuffer" }
      },
      "if": { "properties": { "primaries": { "minItems": 1 } }, "required": ["primaries"] },
      "then": {
        "required": ["acknowledge_external_fencing"],
        "properties": { "acknowledge_external_fencing": { "const": true } }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "primary"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "primary": { "type": "string", "minLength": 1 },
        "replicas": { "type": "array", "default": [], "items": { "$ref": "#/$defs/replica" } },
        "read_after_write_ms": { "$ref": "#/$defs/nonNegativeInteger", "default": 0 },
        "fallback_to_primary": { "type": "boolean", "default": true },
        "read_only": { "type": "boolean", "default": false },
        "failover": { "$ref": "#/$defs/failover" },
        "shadow": { "type": "string", "minLength": 1 }
      }
    }
  }
}
